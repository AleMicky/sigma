{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/datetimepicker": "^9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-constants": "^57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "^57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.20",
    "expo-router": "^57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "15.15.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:clean": "expo prebuild --clean",
    "build:apk": "expo prebuild --platform android && echo \"sdk.dir=$HOME/Library/Android/sdk\" > android/local.properties && cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a,armeabi-v7a,x86_64",
    "build:apk:debug": "expo prebuild --platform android && echo \"sdk.dir=$HOME/Library/Android/sdk\" > android/local.properties && cd android && ./gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a,armeabi-v7a,x86_64",
    "mobile:build:apk": "pnpm run build:apk",
    "mobile:build:apk:debug": "pnpm run build:apk:debug",
    "mobile:prebuild": "pnpm run prebuild:android"
  },
  "private": true
}
