			<expression><![CDATA[$P{APROBADOR_NOMBRE} != null ? $P{APROBADOR_NOMBRE} : ($P{SUPERVISOR_NOMBRE} != null ? $P{SUPERVISOR_NOMBRE} : "Firma")]]></expression>
