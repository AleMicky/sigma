<?xml version="1.0" encoding="UTF-8"?>
<definitions
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:flowable="http://flowable.org/bpmn"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
  targetNamespace="http://endecorani.com/sigma/gestionvehicular"
  exporter="Flowable Open Source Modeler"
  exporterVersion="6.8.0">

  <process
    id="procesoSalidaVehicular"
    name="Proceso de Gestión de Salidas Vehiculares"
    isExecutable="true">

    <startEvent
      id="inicio"
      name="Inicio"
      flowable:formFieldValidation="true"/>

    <!-- PASO 1: SALIDA -->
    <userTask
      id="registrarSalida"
      name="SALIDA - Registrar Salida"
      flowable:assignee="${empleadoId}"
      flowable:candidateGroups="responsable_flota,conductores"
      flowable:formFieldValidation="true">

      <extensionElements>
        <flowable:formProperty
          id="kilometraje"
          name="Kilometraje de Salida"
          type="long"
          required="false"
          writable="true"/>

        <flowable:formProperty
          id="latitud"
          name="Latitud"
          type="string"
          required="false"
          writable="true"/>

        <flowable:formProperty
          id="longitud"
          name="Longitud"
          type="string"
          required="false"
          writable="true"/>
      </extensionElements>
    </userTask>

    <!-- PASO 2: LLEGADA -->
    <userTask
      id="registrarLlegada"
      name="LLEGADA - Registrar Llegada"
      flowable:assignee="${empleadoId}"
      flowable:candidateGroups="responsable_flota,conductores"
      flowable:formFieldValidation="true">

      <extensionElements>
        <flowable:formProperty
          id="kilometraje"
          name="Kilometraje de Llegada"
          type="long"
          required="false"
          writable="true"/>

        <flowable:formProperty
          id="latitud"
          name="Latitud"
          type="string"
          required="false"
          writable="true"/>

        <flowable:formProperty
          id="longitud"
          name="Longitud"
          type="string"
          required="false"
          writable="true"/>
      </extensionElements>
    </userTask>

    <endEvent id="llegada" name="Fin"/>

    <!-- TRANSICIONES -->
    <sequenceFlow
      id="flujo_inicio_salida"
      sourceRef="inicio"
      targetRef="registrarSalida"/>

    <sequenceFlow
      id="flujo_registrar_salida"
      sourceRef="registrarSalida"
      targetRef="registrarLlegada"/>

    <sequenceFlow
      id="flujo_registrar_llegada"
      sourceRef="registrarLlegada"
      targetRef="llegada"/>

  </process>

  <bpmndi:BPMNDiagram
    id="BPMNDiagram_procesoSalidaVehicular">

    <bpmndi:BPMNPlane
      id="BPMNPlane_procesoSalidaVehicular"
      bpmnElement="procesoSalidaVehicular">

      <bpmndi:BPMNShape
        id="BPMNShape_inicio"
        bpmnElement="inicio">
        <omgdc:Bounds
          x="50" y="160"
          width="30" height="30"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
        id="BPMNShape_registrarSalida"
        bpmnElement="registrarSalida">
        <omgdc:Bounds
          x="140" y="135"
          width="130" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
        id="BPMNShape_registrarLlegada"
        bpmnElement="registrarLlegada">
        <omgdc:Bounds
          x="330" y="135"
          width="130" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
        id="BPMNShape_llegada"
        bpmnElement="llegada">
        <omgdc:Bounds
          x="520" y="161"
          width="28" height="28"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge
        id="BPMNEdge_flujo_inicio_salida"
        bpmnElement="flujo_inicio_salida">
        <omgdi:waypoint x="80" y="175"/>
        <omgdi:waypoint x="140" y="175"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
        id="BPMNEdge_flujo_registrar_salida"
        bpmnElement="flujo_registrar_salida">
        <omgdi:waypoint x="270" y="175"/>
        <omgdi:waypoint x="330" y="175"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
        id="BPMNEdge_flujo_registrar_llegada"
        bpmnElement="flujo_registrar_llegada">
        <omgdi:waypoint x="460" y="175"/>
        <omgdi:waypoint x="520" y="175"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
