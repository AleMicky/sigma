  <process id="procesoGestionViajesMovilidad" name="Proceso de Gestión de Viajes y Movilidad" isExecutable="true">
    <startEvent id="inicio" name="Inicio" flowable:formFieldValidation="true"></startEvent>
    <userTask id="crearSolicitud" name="Crear Solicitud" flowable:candidateGroups="solicitantes" flowable:formFieldValidation="true"></userTask>
    <userTask id="enviarSolicitud" name="Enviar Solicitud" flowable:candidateGroups="solicitantes" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:formProperty id="comentario" name="Comentario" type="string"></flowable:formProperty>
      </extensionElements>
    </userTask>
    <userTask id="revisarSolicitud" name="Revisar Solicitud" flowable:assignee="${aprobadorId}" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:formProperty id="accion" name="Decisión" type="enum" required="true">
          <flowable:value id="APROBAR" name="Aprobar"></flowable:value>
          <flowable:value id="OBSERVAR" name="Observar"></flowable:value>
        </flowable:formProperty>
        <flowable:formProperty id="comentario" name="Comentario de Revisión" type="string"></flowable:formProperty>
        <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="decision" name="¿Aprobado?" default="flujo_observar"></exclusiveGateway>
    <userTask id="corregirSolicitud" name="Corregir Solicitud" flowable:candidateGroups="solicitantes" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:formProperty id="comentario" name="Comentario de Ajuste" type="string"></flowable:formProperty>
      </extensionElements>
    </userTask>
    <userTask id="asignarVehiculoConductor" name="Asignar Vehículo y Conductor" flowable:candidateGroups="responsable_flota" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:formProperty id="comentario" name="Detalles de Asignación" type="string"></flowable:formProperty>
      </extensionElements>
    </userTask>
    <userTask id="prepararViaje" name="Preparar Viaje" flowable:candidateGroups="responsable_flota" flowable:formFieldValidation="true"></userTask>
    <userTask id="registrarSalida" name="Registrar Salida" flowable:assignee="${conductorDesignadoId}" flowable:formFieldValidation="true">
      <extensionElements>
        <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
      </extensionElements>
    </userTask>
    <userTask id="registrarRetorno" name="Registrar Retorno" flowable:assignee="${conductorDesignadoId}" flowable:formFieldValidation="true">
      <extensionElements>
        <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
      </extensionElements>
    </userTask>
    <endEvent id="finalizado" name="Viaje Finalizado"></endEvent>
    <sequenceFlow id="flujo_inicio_crear" sourceRef="inicio" targetRef="crearSolicitud"></sequenceFlow>
    <sequenceFlow id="flujo_crear_enviar" sourceRef="crearSolicitud" targetRef="enviarSolicitud"></sequenceFlow>
    <sequenceFlow id="flujo_enviar_revisar" sourceRef="enviarSolicitud" targetRef="revisarSolicitud"></sequenceFlow>
    <sequenceFlow id="flujo_revisar_decision" sourceRef="revisarSolicitud" targetRef="decision"></sequenceFlow>
    <sequenceFlow id="flujo_aprobar" name="APROBAR" sourceRef="decision" targetRef="asignarVehiculoConductor">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${accion == 'APROBAR'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flujo_observar" name="OBSERVAR" sourceRef="decision" targetRef="corregirSolicitud"></sequenceFlow>
    <sequenceFlow id="flujo_corregir_revisar" sourceRef="corregirSolicitud" targetRef="revisarSolicitud"></sequenceFlow>
    <sequenceFlow id="flujo_asignar_preparar" sourceRef="asignarVehiculoConductor" targetRef="prepararViaje"></sequenceFlow>
    <sequenceFlow id="flujo_preparar_salida" sourceRef="prepararViaje" targetRef="registrarSalida"></sequenceFlow>
    <sequenceFlow id="flujo_salida_retorno" sourceRef="registrarSalida" targetRef="registrarRetorno"></sequenceFlow>
    <sequenceFlow id="flujo_retorno_finalizado" sourceRef="registrarRetorno" targetRef="finalizado"></sequenceFlow>
  </process>
