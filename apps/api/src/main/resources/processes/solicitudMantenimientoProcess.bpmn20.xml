<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://endecorani.com/sigma/mantenimiento" exporter="Flowable Open Source Modeler" exporterVersion="6.8.0">
  <process id="solicitudMantenimientoProcess" name="Solicitud de Mantenimiento" isExecutable="true">
    <startEvent id="startEvent" name="Inicio" flowable:formFieldValidation="true"></startEvent>
    
    <!-- ESTADO BORRADOR: ASIGNAR APROBADOR RESPONSABLE -->
    <userTask
      id="borradorSolicitud"
      name="BORRADOR - Asignar Aprobador Responsable"
      flowable:assignee="${solicitanteId}"
      flowable:formFieldValidation="true">
      <extensionElements>
        <!-- LISTADO DE APROBADORES ASIGNADOS AL EMPLEADO/SOLICITANTE -->
        <flowable:formProperty
          id="aprobadorId"
          name="Aprobador responsable"
          type="string"
          required="true"
          writable="true"
          xmlns:sigma="http://endecorani.com/sigma/workflow"
          sigma:component="select"
          sigma:source="rest"
          sigma:url="/api/v1/grupos-aprobadores/empleados/${solicitanteId}/aprobadores/select">
        </flowable:formProperty>

        <!-- COMENTARIO -->
        <flowable:formProperty
          id="comentario"
          name="Comentario"
          type="string"
          required="false"
          writable="true">
        </flowable:formProperty>
      </extensionElements>
    </userTask>

    <!-- ESTADO SOLICITADO: REVISAR SOLICITUD Y ASIGNAR RESPONSABLE -->
    <userTask
      id="revisarSolicitud"
      name="SOLICITADO - Revisar solicitud"
      flowable:assignee="${aprobadorId}"
      flowable:formFieldValidation="true">
      <extensionElements>
        <!-- LISTADO DE RESPONSABLES (DEPENDIENTES DEL APROBADOR) -->
        <flowable:formProperty
          id="responsableId"
          name="Responsable de mantenimiento"
          type="string"
          required="true"
          writable="true"
          xmlns:sigma="http://endecorani.com/sigma/workflow"
          sigma:component="select"
          sigma:source="rest"
          sigma:url="/api/v1/grupos-aprobadores/aprobadores/${aprobadorId}/dependientes/select">
        </flowable:formProperty>

        <!-- COMENTARIO -->
        <flowable:formProperty
          id="comentario"
          name="Comentario"
          type="string"
          required="false"
          writable="true">
        </flowable:formProperty>
      </extensionElements>
    </userTask>

    <exclusiveGateway id="gatewayDecisionCoordinador" name="Decisión del coordinador"></exclusiveGateway>
    <userTask id="corregirSolicitud" name="OBSERVADO - Corregir y reenviar solicitud" flowable:assignee="${solicitanteId}" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:formProperty id="comentario" name="Comentario de subsanación" type="string" required="true" writable="true"></flowable:formProperty>
      </extensionElements>
    </userTask>
    <userTask id="iniciarMantenimiento" name="ASIGNADO - Iniciar mantenimiento" flowable:assignee="${responsableId}" flowable:formFieldValidation="true">
      <extensionElements>
        <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
      </extensionElements>
    </userTask>
    <userTask id="ejecutarMantenimiento" name="EN_MANTENIMIENTO - Ejecutar mantenimiento" flowable:assignee="${responsableId}" flowable:formFieldValidation="true">
      <extensionElements>
        <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
      </extensionElements>
    </userTask>
    <userTask id="enviarRevision" name="EN_MANTENIMIENTO - Enviar a revisión" flowable:assignee="${responsableId}" flowable:formFieldValidation="true">
      <extensionElements>
        <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
        <flowable:formProperty id="comentario" name="Detalle del trabajo completado" type="string" required="false" writable="true"></flowable:formProperty>
      </extensionElements>
    </userTask>
    <userTask id="revisarMantenimiento" name="EN_REVISION - Revisar mantenimiento" flowable:assignee="${supervisorId}" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:formProperty id="comentario" name="Comentario de supervisión" type="string" required="false" writable="true"></flowable:formProperty>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="gatewayDecisionSupervisor" name="Decisión del supervisor"></exclusiveGateway>
    <userTask id="corregirMantenimiento" name="OBSERVADO_MANTENIMIENTO - Corregir mantenimiento" flowable:assignee="${responsableId}" flowable:formFieldValidation="true">
      <extensionElements>
        <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
        <flowable:formProperty id="comentario" name="Detalle de correcciones realizadas" type="string" required="true" writable="true"></flowable:formProperty>
      </extensionElements>
    </userTask>
    <userTask id="registrarTrabajo" name="VALIDADO - Registrar trabajo realizado" flowable:assignee="${responsableId}" flowable:formFieldValidation="true">
      <extensionElements>
        <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
      </extensionElements>
    </userTask>
    <userTask id="recibirActivo" name="TRABAJO_REALIZADO - Recibir y verificar activo" flowable:assignee="${solicitanteId}" flowable:formFieldValidation="true">
      <extensionElements>
        <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
        <flowable:formProperty id="comentario" name="Comentario de conformidad" type="string" required="false" writable="true"></flowable:formProperty>
      </extensionElements>
    </userTask>
    <endEvent id="endEvent" name="FINALIZADO"></endEvent>

    <!-- FLUJOS -->
    <sequenceFlow id="flowStart" sourceRef="startEvent" targetRef="borradorSolicitud"></sequenceFlow>
    <sequenceFlow id="flowEnviarAprobador" name="Enviar a aprobación" sourceRef="borradorSolicitud" targetRef="revisarSolicitud"></sequenceFlow>
    <sequenceFlow id="flow2" sourceRef="revisarSolicitud" targetRef="gatewayDecisionCoordinador"></sequenceFlow>
    <sequenceFlow id="flow3" name="Observar" sourceRef="gatewayDecisionCoordinador" targetRef="corregirSolicitud">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionCoordinador == 'OBSERVAR'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow4" name="Aprobar" sourceRef="gatewayDecisionCoordinador" targetRef="iniciarMantenimiento">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionCoordinador == 'APROBAR'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow5" name="Reenviar" sourceRef="corregirSolicitud" targetRef="revisarSolicitud"></sequenceFlow>
    <sequenceFlow id="flow7" name="Iniciar mantenimiento" sourceRef="iniciarMantenimiento" targetRef="ejecutarMantenimiento"></sequenceFlow>
    <sequenceFlow id="flow8" sourceRef="ejecutarMantenimiento" targetRef="enviarRevision"></sequenceFlow>
    <sequenceFlow id="flow9" name="Enviar a revisión" sourceRef="enviarRevision" targetRef="revisarMantenimiento"></sequenceFlow>
    <sequenceFlow id="flow10" sourceRef="revisarMantenimiento" targetRef="gatewayDecisionSupervisor"></sequenceFlow>
    <sequenceFlow id="flow11" name="Observar" sourceRef="gatewayDecisionSupervisor" targetRef="corregirMantenimiento">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionSupervisor == 'OBSERVAR'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow12" name="Validar" sourceRef="gatewayDecisionSupervisor" targetRef="registrarTrabajo">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decisionSupervisor == 'VALIDAR'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow13" name="Corregir" sourceRef="corregirMantenimiento" targetRef="revisarMantenimiento"></sequenceFlow>
    <sequenceFlow id="flow14" name="Registrar trabajo" sourceRef="registrarTrabajo" targetRef="recibirActivo"></sequenceFlow>
    <sequenceFlow id="flow15" name="Recibir y cerrar" sourceRef="recibirActivo" targetRef="endEvent"></sequenceFlow>
  </process>
