SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sigma_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Modo SSL de la BD: "disable" para dev/test local sin TLS.
# En producción compose.prod.yml usa "prefer" por defecto; cambiar a "require" cuando PostgreSQL soporte SSL.
DB_SSL_MODE=disable

# Orígenes permitidos para el BFF (dev 3000/5173 y puertos alternos 3001).
# En .env.test y producción se debe ajustar al dominio real.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# URL base de Keycloak: usar el hostname real de cada entorno, sin IP fija.
KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_REALM=sigma
KEYCLOAK_ISSUER_URI=https://keycloak.example.com/realms/sigma
KEYCLOAK_TOKEN_URL=https://keycloak.example.com/realms/sigma/protocol/openid-connect/token
KEYCLOAK_LOGOUT_URL=https://keycloak.example.com/realms/sigma/protocol/openid-connect/logout

# Único client Keycloak: sigma-web (BFF password grant).
# Client authentication ON + Direct access grants ON + audience mapper aud=sigma-api.
KEYCLOAK_CLIENT_ID=sigma-web
KEYCLOAK_CLIENT_SECRET=change-me
# Audience esperado por la API: sigma-api (sin "account"). Requiere mapper aud=sigma-api en sigma-web.
KEYCLOAK_AUDIENCE=sigma-api
# Tolerancia en segundos para validar exp/nbf del JWT; 0 deshabilita la tolerancia.
KEYCLOAK_JWT_CLOCK_SKEW_SECONDS=60

# Flowable BPMN Engine
FLOWABLE_BASE_URL=https://flowable.example.com/flowable-rest/service
FLOWABLE_USERNAME=admin
FLOWABLE_PASSWORD=change-me

# ── Almacenamiento de archivos (API) ─────────────────────────
# "./uploads" resuelve a /app/uploads dentro del contenedor (WORKDIR=/app).
STORAGE_BASE_DIR=./uploads
STORAGE_MAX_FILE_SIZE=20MB
STORAGE_MAX_REQUEST_SIZE=20MB
# Imágenes: 20 MiB (20 * 1024 * 1024), alineado con spring.servlet.multipart.max-file-size=20MB.
# El límite lo aplica la API; Nginx solo hace de colchón (32M en /api/).
STORAGE_MAX_FILE_SIZE_BYTES=20971520
DOCUMENTS_MAX_FILE_SIZE_BYTES=20971520

VITE_API_URL=http://localhost:8080
VITE_APP_NAME=SIGMA

# ── Docker ─────────────────────────────────────────────────────
# docker compose up -d        → levanta todo el stack
# docker compose up -d --build → reconstruye las imágenes
#
# Nota: DB_HOST se sobreescribe a "postgres" dentro de Docker.
# Las variables VITE_* se inyectan al build del frontend.
