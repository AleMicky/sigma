SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sigma_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

CORS_ALLOWED_ORIGINS=http://localhost:5173

KEYCLOAK_ISSUER_URI=http://157.173.99.216:8081/realms/sigma
KEYCLOAK_TOKEN_URL=http://157.173.99.216:8081/realms/sigma/protocol/openid-connect/token

# Único client Keycloak: sigma-web (BFF password grant).
# Client authentication ON + Direct access grants ON + audience mapper aud=sigma-api.
KEYCLOAK_CLIENT_ID=sigma-web
KEYCLOAK_CLIENT_SECRET=change-me
# Audience esperado además de "account" (default Keycloak). Opcional: mapper aud=sigma-api.
KEYCLOAK_AUDIENCE=sigma-api

VITE_API_URL=http://localhost:8080
