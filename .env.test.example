# Plantilla de fallback para compose.test.yml cuando aún no existe .env.test.
# Copiar a .env.test y completar valores reales antes de desplegar.
SPRING_PROFILES_ACTIVE=test
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sigma_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://sigma-test.endecorani.bo

KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_REALM=sigma
KEYCLOAK_ISSUER_URI=https://keycloak.example.com/realms/sigma
KEYCLOAK_TOKEN_URL=https://keycloak.example.com/realms/sigma/protocol/openid-connect/token
KEYCLOAK_LOGOUT_URL=https://keycloak.example.com/realms/sigma/protocol/openid-connect/logout

KEYCLOAK_CLIENT_ID=sigma-web
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_AUDIENCE=sigma-api
# Tolerancia en segundos para validar exp/nbf del JWT; 0 deshabilita la tolerancia.
KEYCLOAK_JWT_CLOCK_SKEW_SECONDS=60

FLOWABLE_BASE_URL=https://flowable.example.com/flowable-rest/service
FLOWABLE_USERNAME=admin
FLOWABLE_PASSWORD=change-me

STORAGE_BASE_DIR=./uploads
STORAGE_MAX_FILE_SIZE=20MB
STORAGE_MAX_REQUEST_SIZE=20MB
STORAGE_MAX_FILE_SIZE_BYTES=20971520
DOCUMENTS_MAX_FILE_SIZE_BYTES=20971520

VITE_API_URL=https://sigma-test.endecorani.bo
VITE_APP_NAME=SIGMA
